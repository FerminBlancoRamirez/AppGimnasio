<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login"
    android:background="@color/black">
    <!-- En esta fragment creamos la pantalla de inicio de sesion -->

    <!-- Añadimos logo de app -->
    <ImageView
        android:id="@+id/iV_iconSingUp"
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:src="@drawable/splash_screen"
        android:layout_gravity="center_horizontal"
        />

    <!--Creamos un LinnerLayout para ordenar las palabras del nombre de una manera vertical-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginBottom="110dp">
        <!-- El orden lo pondriamos con el orientation -->

        <!-- Añadimos los dos textos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/first_word"
            android:layout_gravity="center_horizontal"
            android:textSize="60dp"
            android:fontFamily="@font/caacupeone_regular"
            android:textColor="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/second_word"
            android:layout_gravity="center_horizontal"
            android:textSize="60dp"
            android:fontFamily="@font/caacupeone_regular"
            android:textColor="@color/green"/>
    </LinearLayout>

    <!-- Se crea un materialCard para agrupar todos los elementos importantes del
    inicio de sesion para darle un estilo visual mejorado-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mCInicioSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/soft_green"
        android:layout_gravity="center"
        android:padding="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="130dp">

        <!-- Encapsulamos todo en un LinnerLayout para tenerlo todo ordenador-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:padding="13dp">

            <!--Añadimos texto principal-->
            <TextView
                android:id="@+id/tVInicioSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:fontFamily="@font/poppins_medium"
                android:textSize="30dp"
                android:textColor="@color/black"
                android:paddingBottom="15dp"
                android:layout_gravity="center" />

            <!--Recogemos el email del usuario-->
            <TextView
                android:id="@+id/tVEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="@string/email"
                android:textSize="20dp"
                android:fontFamily="@font/poppins_semibold"/>

            <EditText
                android:id="@+id/eTEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:hint="@string/ejemplo_correo"
                android:inputType="textEmailAddress"/> <!--Con esta linea conseguimos que se solicite siempre un email-->

            <!--Recogemos la constraseña del usuario-->
            <TextView
                android:id="@+id/tVContraseña"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="@string/pasword"
                android:textSize="20dp"
                android:fontFamily="@font/poppins_semibold"
                android:paddingTop="15dp"/>

            <EditText
                android:id="@+id/eTContraseña"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:hint="@string/restricciones_contraseña"
                android:inputType="textPassword"/> <!-- Con esta linea conseguimos buscar un formato contraseña-->

            <!-- Añadimos un boton con el cual se revisara sin la informacion dada es valida y se pueda iniciar sesion--> -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mBIniciarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/green"
                android:text="@string/login"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>

            <!-- Añadimos un texto que tendra funcion de boton con el cual se podra ir a otro registro
             por si te olvidaste de la contraseña-->
            <TextView
                android:id="@+id/tVContraseñaOlvidada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:text="@string/forgot_password"
                android:textColor="@color/green"
                android:fontFamily="@font/poppins_medium"
                android:textSize="10sp"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>



</FrameLayout>